# Copy to .env and fill in. Never commit .env.
DB_USER=sacco
DB_PASSWORD=change-me
DB_NAME=sacco
JWT_SECRET=change-me-long-random-string

# URL the browser uses to reach the backend
PUBLIC_API_URL=http://localhost:5000
# Booking API used by the portal (set to the real booking backend)
PORTAL_API_URL=
